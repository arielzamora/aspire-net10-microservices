@page "/login"
@using MasterNet.Client.Refit
@inject IAccountApi AccountApi
@inject AuthTokenStore Auth
@inject NavigationManager Navigation

<PageTitle>Sign in</PageTitle>

<h1 class="mb-3">Sign in</h1>

<EditForm Model="_model" OnValidSubmit="SignInAsync" class="card card-body shadow-sm" style="max-width: 28rem;">
    <div class="mb-3">
        <label class="form-label" for="loginEmail">Email</label>
        <InputText @bind-Value="_model.Email" id="loginEmail" type="email" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="loginPassword">Password</label>
        <InputText @bind-Value="_model.Password" id="loginPassword" type="password" class="form-control" />
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @_errorMessage
        </div>
    }

    <button class="btn btn-primary" type="submit" disabled="@_isSigningIn">
        @(_isSigningIn ? "Signing in..." : "Sign in")
    </button>
</EditForm>

@code {
    private readonly LoginRequest _model = new();
    private bool _isSigningIn;
    private string? _errorMessage;

    private async Task SignInAsync()
    {
        _isSigningIn = true;
        _errorMessage = null;

        try
        {
            using var response = await AccountApi.LoginAsync(_model);

            if (response.IsSuccessStatusCode && !string.IsNullOrEmpty(response.Content?.Token))
            {
                await Auth.SignInAsync(response.Content.Token, response.Content.Email);
                Navigation.NavigateTo("courses");
                return;
            }

            _errorMessage = response.IsSuccessStatusCode
                ? "The server did not return a token."
                : ApiErrors.Describe(response.StatusCode, response.Error?.Content);
        }
        catch (Exception ex)
        {
            _errorMessage = "Unable to sign in at this time.";
            Console.Error.WriteLine(ex);
        }
        finally
        {
            _isSigningIn = false;
        }
    }
}
