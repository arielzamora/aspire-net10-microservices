@implements IDisposable
@inject AuthTokenStore Auth

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">MasterNet.Client</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="courses">
                <span class="bi bi-journal-bookmark-fill-nav-menu" aria-hidden="true"></span> Courses
            </NavLink>
        </div>
        <div class="nav-item px-3">
            @if (Auth.IsAuthenticated)
            {
                <button class="nav-link btn btn-link" @onclick="SignOutAsync" @onclick:stopPropagation="true">
                    Sign out (@Auth.Email)
                </button>
            }
            else
            {
                <NavLink class="nav-link" href="login">
                    Sign in
                </NavLink>
            }
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    protected override async Task OnInitializedAsync()
    {
        Auth.Changed += OnAuthChanged;
        await Auth.EnsureLoadedAsync();
    }

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    private Task SignOutAsync() => Auth.SignOutAsync();

    public void Dispose() => Auth.Changed -= OnAuthChanged;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
